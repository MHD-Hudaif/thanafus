RewriteEngine On
DirectoryIndex index.php

# =====================================================
# REMOVE INDEX.PHP FROM URLS
# Redirect /path/index.php -> /path/
# =====================================================
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s(.*)/index\.php([^\s]*)\sHTTP [NC]
RewriteRule ^(.*)index\.php$ %1 [R=301,L]

# =====================================================
# REDIRECT DIRECT .PHP REQUESTS TO CLEAN EXTENSIONLESS URLS
# Redirect /path/page.php -> /path/page
# =====================================================
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s([^\s?]+)\.php([^\s]*)\sHTTP [NC]
RewriteRule ^(.*)\.php$ %1 [R=301,L]

# =====================================================
# REMOVE TRAILING SLASH FOR NON-DIRECTORIES
# =====================================================

RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ $1 [R=301,L]

# =====================================================
# PREVENT DIRECTORY LISTING
# =====================================================

Options -Indexes

# =====================================================
# EXTENSIONLESS PHP ROUTES
# Allows /home, /admin/dashboard, /auth/login, /tv/schedule
# without hardcoding the deployment folder name.
# =====================================================

RewriteCond %{REQUEST_URI} !\.php$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]
